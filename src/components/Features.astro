---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang).features;

const icons = [
  `<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
];
const colors = ['--cyan', '--indigo', '--emerald'] as const;
const colorKeys = ['cyan', 'indigo', 'emerald'] as const;
---

<section class="section features" id="features">
  <div class="container">
    <div class="section-label">{t.label}</div>
    <h2 class="features__title reveal">
      {t.title.split('\n').map((line, i) => (
        <>{line}{i < t.title.split('\n').length - 1 && <br/>}</>
      ))}
    </h2>

    <div class="features__row features__row--top reveal">
      {t.cards.map((card, i) => (
        <div class={`feat-card ${i === 0 ? 'feat-card--hero' : 'feat-card--side'}`}>
          <div class={`feat-card__icon-wrap feat-card__icon-wrap--${colorKeys[i]}`} set:html={icons[i]} />
          <h3>{card.title}</h3>
          <p>{card.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.features__title {
  font-size: clamp(30px, 3.8vw, 50px);
  font-weight: 900;
  letter-spacing: -0.03em;
  margin-bottom: 52px;
  max-width: 520px;
  line-height: 1.05;
}

.features__row {
  display: grid;
  gap: 14px;
}

.features__row--top {
  grid-template-columns: repeat(3, 1fr);
  align-items: stretch;
}

.feat-card {
  background: rgba(255 255 255 / 0.03);
  border: 1px solid rgba(255 255 255 / 0.07);
  border-radius: 18px;
  padding: 28px;
  transition: border-color 0.25s, background 0.25s, transform 0.2s;
}
.feat-card:hover {
  background: rgba(255 255 255 / 0.05);
  border-color: rgba(255 255 255 / 0.14);
  transform: translateY(-2px);
}

.feat-card--hero {
  display: flex;
  flex-direction: column;
}

.feat-card__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  border-radius: 12px;
  margin-bottom: 20px;
  flex-shrink: 0;
}
.feat-card__icon-wrap--cyan    { background: rgba(167 139 250 / 0.1); border: 1px solid rgba(167 139 250 / 0.2); color: #A78BFA; }
.feat-card__icon-wrap--indigo  { background: rgba(99 102 241 / 0.1);  border: 1px solid rgba(99 102 241 / 0.2);  color: #6366F1; }
.feat-card__icon-wrap--emerald { background: rgba(52 211 153 / 0.1);  border: 1px solid rgba(52 211 153 / 0.2);  color: #34D399; }

.feat-card h3 {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 10px;
  color: var(--text);
}
.feat-card p {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.7;
}

@media (max-width: 860px) {
  .features__row--top { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 560px) {
  .features__row--top { grid-template-columns: 1fr; }
}
</style>
