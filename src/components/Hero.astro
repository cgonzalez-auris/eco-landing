---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
import { DOWNLOAD } from '../config';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const h = t.hero;
const d = t.download;
const base = lang === 'en' ? '/en' : '';
---
<section class="hero">
  <!-- Background orbs -->
  <div class="hero__orb hero__orb--1" aria-hidden="true"></div>
  <div class="hero__orb hero__orb--2" aria-hidden="true"></div>
  <div class="hero__orb hero__orb--3" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__content">
      <div class="pill pill--hero">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {h.pill}
      </div>

      <h1 class="hero__title">
        {h.title1}<br/>
        {h.title2}<br/>
        <span class="hero__accent">{h.titleAccent}</span>
      </h1>

      <p class="hero__sub">{h.subtitle}</p>

      <div class="hero__ctas">
        <a
          href={DOWNLOAD.mac.path}
          class="btn btn-primary"
          data-track="download_click"
          data-track-plataforma="mac"
          data-track-ubicacion="hero"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          {h.cta1}
        </a>
        <a href={`${base}/#pricing`} class="btn btn-ghost">
          {h.cta2}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>

      <div class="hero__stores">
        <a
          href={DOWNLOAD.appStore}
          class="store-link"
          target="_blank"
          rel="noopener"
          data-track="store_click"
          data-track-tienda="app_store"
          data-track-ubicacion="hero"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11.5" fill="#0D96F6"/><g stroke="#fff" stroke-width="1.9" stroke-linecap="round"><path d="M8.1 17.4 14.1 7"/><path d="M9.9 7l6 10.4"/><path d="M6.3 14.1h11.4"/></g></svg>
          {d.appStore}
        </a>
        <a
          href={DOWNLOAD.playStore}
          class="store-link"
          target="_blank"
          rel="noopener"
          data-track="store_click"
          data-track-tienda="play_store"
          data-track-ubicacion="hero"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="#34A853" d="M3.6 21.4 14 13.3l2.7 2.7-11 6.3c-.8.5-1.7.2-2.1-.9z"/><path fill="#EA4335" d="M3.6 2.6 14 10.7 16.7 8l-11-6.3c-.8-.5-1.7-.2-2.1.9z"/><path fill="#FBBC04" d="m16.7 8 4 2.3c1 .6 1 2.2 0 2.8l-4 2.2-3.1-2.9L16.7 8z"/><path fill="#4285F4" d="M3.6 2.6c-.1.2-.1.4-.1.7v17.4c0 .3 0 .5.1.7L13.6 12 3.6 2.6z"/></svg>
          {d.playStore}
        </a>
      </div>

      <p class="hero__note">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        {h.note}
      </p>
    </div>

    <!-- Live caption window mockup -->
    <div class="hero__demo" aria-hidden="true">
      <div class="caption-window">
        <div class="caption-window__bar">
          <span class="dot dot--red"></span>
          <span class="dot dot--yellow"></span>
          <span class="dot dot--green"></span>
          <span class="caption-window__title">{h.windowTitle}</span>
          <span class="live-badge">
            <span class="live-dot"></span>
            LIVE
          </span>
        </div>
        <div class="caption-window__body">
          <div class="caption-source">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/></svg>
            {h.captionSource}
          </div>
          <p class="caption-line caption-original">
            <span class="typing-text">{h.captionOriginal}</span>
          </p>
          <div class="caption-divider">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            {h.captionTranslationLabel}
          </div>
          <p class="caption-line caption-translation">
            <span class="typing-text">{h.captionTranslation}</span>
          </p>
        </div>
        <div class="caption-window__footer">
          <span class="waveform" role="presentation">
            <span></span><span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span><span></span><span></span>
          </span>
          <span class="footer-meta">{h.captionFooter}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* ─── Hero section ──────────────────────────────────────────────────── */
.hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  align-items: center;
  padding-block: 120px 80px;
  overflow: hidden;
}

.hero__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(40px, 6vw, 80px);
  align-items: center;
}

/* ─── Background orbs ───────────────────────────────────────────────── */
.hero__orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  opacity: 0.28;
}
.hero__orb--1 {
  width: 700px; height: 700px;
  background: radial-gradient(circle, #7C3AED, transparent 70%);
  top: -250px; left: -150px;
  animation: float1 14s ease-in-out infinite;
}
.hero__orb--2 {
  width: 500px; height: 500px;
  background: radial-gradient(circle, #4C1D95, transparent 70%);
  bottom: -100px; right: -50px;
  animation: float2 18s ease-in-out infinite;
}
.hero__orb--3 {
  width: 350px; height: 350px;
  background: radial-gradient(circle, #A78BFA, transparent 70%);
  top: 45%; left: 52%;
  animation: float3 12s ease-in-out infinite;
  opacity: 0.18;
}

@keyframes float1 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(40px, 40px) scale(1.05); } }
@keyframes float2 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-30px, -30px) scale(1.08); } }
@keyframes float3 { 0%, 100% { transform: translate(-50%, -50%); } 50% { transform: translate(-50%, calc(-50% + 20px)); } }

/* ─── Content ───────────────────────────────────────────────────────── */
.pill--hero {
  background: rgba(124 58 237 / 0.14);
  border: 1px solid rgba(167 139 250 / 0.3);
  color: #C4B5FD;
  margin-bottom: 24px;
}

.hero__title {
  font-size: clamp(42px, 5vw, 68px);
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: -0.04em;
  margin-bottom: 24px;
}
.hero__accent {
  color: var(--cyan);
}

.hero__sub {
  font-size: clamp(16px, 1.8vw, 18px);
  color: var(--text-muted);
  line-height: 1.7;
  max-width: 480px;
  margin-bottom: 36px;
}

.hero__ctas {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}

/* Las tiendas van bajo los CTAs y no como botones: la acción principal desde un
   navegador de escritorio es bajarse el .dmg, y estos dos son el recordatorio de
   que la misma cuenta sirve en el móvil. */
.hero__stores {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.store-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.16s ease;
}

.store-link:hover {
  color: #fff;
}

.hero__note {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  color: var(--text-faint);
}

/* ─── Caption window mockup ─────────────────────────────────────────── */
.hero__demo {
  position: relative;
  display: flex;
  justify-content: center;
}

.caption-window {
  background: rgba(13 21 37 / 0.9);
  border: 1px solid var(--border-hi);
  border-radius: var(--r-lg);
  overflow: hidden;
  width: 100%;
  max-width: 480px;
  box-shadow:
    0 0 0 1px rgba(34 211 238 / 0.06),
    0 32px 80px rgba(0 0 0 / 0.6),
    inset 0 1px 0 rgba(255 255 255 / 0.06);
}

.caption-window__bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  background: rgba(255 255 255 / 0.03);
  border-bottom: 1px solid var(--border);
}

.dot {
  width: 10px; height: 10px;
  border-radius: 50%;
}
.dot--red    { background: #FF5F57; }
.dot--yellow { background: #FEBC2E; }
.dot--green  { background: #28C840; }

.caption-window__title {
  flex: 1;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-faint);
  text-align: center;
  padding-left: 8px;
}

.live-badge {
  display: flex;
  align-items: center;
  gap: 5px;
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 500;
  letter-spacing: 0.1em;
  color: #C4B5FD;
  background: rgba(167 139 250 / 0.12);
  border: 1px solid rgba(167 139 250 / 0.25);
  padding: 2px 8px;
  border-radius: 99px;
}

.live-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #A78BFA;
  animation: pulse-dot 1.8s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.4; transform: scale(0.7); }
}

.caption-window__body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.caption-source {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-faint);
  letter-spacing: 0.04em;
}

.caption-line {
  font-size: 14px;
  line-height: 1.6;
}

.caption-original {
  color: var(--text);
  font-weight: 400;
}

.caption-divider {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: var(--font-mono);
  font-size: 10px;
  color: #A78BFA;
  letter-spacing: 0.04em;
  opacity: 0.7;
}

.caption-translation {
  color: var(--text-muted);
  font-style: italic;
}

/* Typing animation — controlada por el script typewriter */
.typing-text {
  opacity: 0;
}

@media (prefers-reduced-motion: reduce) {
  .typing-text { opacity: 1; }
}

/* ─── Waveform ──────────────────────────────────────────────────────── */
.caption-window__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  border-top: 1px solid var(--border);
  background: rgba(255 255 255 / 0.02);
}

.waveform {
  display: flex;
  align-items: center;
  gap: 2px;
  height: 16px;
}
.waveform span {
  display: block;
  width: 3px;
  background: #A78BFA;
  border-radius: 2px;
  opacity: 0.7;
  animation: wave 1.2s ease-in-out infinite;
}
.waveform span:nth-child(1) { height: 4px;  animation-delay: 0s; }
.waveform span:nth-child(2) { height: 8px;  animation-delay: 0.1s; }
.waveform span:nth-child(3) { height: 12px; animation-delay: 0.2s; }
.waveform span:nth-child(4) { height: 16px; animation-delay: 0.3s; }
.waveform span:nth-child(5) { height: 10px; animation-delay: 0.4s; }
.waveform span:nth-child(6) { height: 14px; animation-delay: 0.3s; }
.waveform span:nth-child(7) { height: 8px;  animation-delay: 0.2s; }
.waveform span:nth-child(8) { height: 12px; animation-delay: 0.1s; }
.waveform span:nth-child(9) { height: 6px;  animation-delay: 0.05s; }
.waveform span:nth-child(10){ height: 3px;  animation-delay: 0s; }

@keyframes wave {
  0%, 100% { transform: scaleY(0.5); opacity: 0.4; }
  50% { transform: scaleY(1); opacity: 1; }
}

.footer-meta {
  font-family: var(--font-mono);
  font-size: 9px;
  color: var(--text-faint);
  letter-spacing: 0.04em;
}

/* ─── Responsive ────────────────────────────────────────────────────── */
@media (max-width: 900px) {
  .hero__inner {
    grid-template-columns: 1fr;
    text-align: center;
  }
  .hero__sub { margin-inline: auto; }
  .hero__ctas { justify-content: center; }
  .hero__stores { justify-content: center; }
  .hero__note { justify-content: center; }
  .hero__demo { margin-top: 24px; }
  .caption-window { max-width: 440px; margin-inline: auto; }
}
</style>

<script>
  // Typewriter: letra por letra, sin cursor, sin demora inicial
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const spans = document.querySelectorAll<HTMLElement>('.hero__demo .typing-text');
    if (spans.length < 2) return;

    const [original, translation] = Array.from(spans);
    const textOriginal    = original.textContent    ?? '';
    const textTranslation = translation.textContent ?? '';

    original.textContent    = '';
    translation.textContent = '';
    original.style.opacity    = '1';
    translation.style.opacity = '1';

    const SPEED_MS  = 6;   // ms por carácter
    const PAUSE_MS  = 350;  // pausa entre las dos líneas

    function typeChars(el: HTMLElement, text: string): Promise<void> {
      return new Promise((resolve) => {
        let i = 0;
        const tick = () => {
          if (i < text.length) {
            el.textContent += text[i++];
            setTimeout(tick, SPEED_MS);
          } else {
            resolve();
          }
        };
        tick();
      });
    }

    typeChars(original, textOriginal)
      .then(() => new Promise<void>((r) => setTimeout(r, PAUSE_MS)))
      .then(() => typeChars(translation, textTranslation));
  })();
</script>
