---
/**
 * Hub de /tools. Es la puerta de entrada del cluster: desde aquí se llega a
 * las trece herramientas y hacia aquí apuntan el nav y el footer de todo el
 * sitio, que es como Google las descubre.
 */
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import type { Lang } from '../../i18n/ui';
import { useToolTranslations } from '../../i18n/tools';
import {
  CATEGORY_ORDER,
  TOOLS_INDEX_ALTERNATES,
  TOOL_SLUGS,
  slugsIn,
  toolPath,
  toolsIndexPath,
} from '../../lib/tools';
import { SITE } from '../../config';
import '../../styles/global.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;

const t = useToolTranslations(lang);
const homePath = lang === 'en' ? '/en/' : '/';
const indexUrl = `${SITE.url}${toolsIndexPath(lang)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t.index.title.replace('\n', ' '),
    description: t.index.metaDescription,
    url: indexUrl,
    inLanguage: lang,
    hasPart: TOOL_SLUGS.map(slug => ({
      '@type': 'WebApplication',
      name: t.tools[slug].h1,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      url: `${SITE.url}${toolPath(slug, lang)}`,
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.chrome.breadcrumbHome, item: `${SITE.url}${homePath}` },
      { '@type': 'ListItem', position: 2, name: t.chrome.breadcrumbTools, item: indexUrl },
    ],
  },
];
---

<Layout
  lang={lang}
  title={t.index.metaTitle}
  description={t.index.metaDescription}
  canonical={indexUrl}
  alternates={TOOLS_INDEX_ALTERNATES}
  productJsonLd={false}
>
  <Nav lang={lang} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main class="tools-index">
    <div class="container">

      <nav class="tool-crumbs" aria-label="Breadcrumb">
        <a href={homePath}>{t.chrome.breadcrumbHome}</a>
        <span aria-hidden="true">/</span>
        <span class="tool-crumbs__current">{t.chrome.breadcrumbTools}</span>
      </nav>

      <header class="tools-index__head">
        <div class="section-label">{t.index.eyebrow}</div>
        <h1>
          {t.index.title.split('\n').map((line, i) => (
            <>{line}{i < t.index.title.split('\n').length - 1 && <br />}</>
          ))}
        </h1>
        <p class="tools-index__sub">{t.index.sub}</p>
        <p class="tools-index__count">{t.index.countLabel}</p>
      </header>

      {CATEGORY_ORDER.map(category => (
        <section class="tools-group">
          <h2 class="tools-group__title">{t.categories[category]}</h2>
          <ul class="tools-grid">
            {slugsIn(category).map(slug => (
              <li>
                <a
                  href={toolPath(slug, lang)}
                  data-track="tool_open"
                  data-track-herramienta={slug}
                  data-track-ubicacion="hub"
                >
                  <span class="tools-card__title">{t.tools[slug].cardTitle}</span>
                  <span class="tools-card__blurb">{t.tools[slug].cardBlurb}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="tools-cta glass-card">
        <h2>{t.chrome.ctaTitle}</h2>
        <p>{t.chrome.ctaSub}</p>
        <a
          href={`${homePath}#download`}
          class="btn btn-primary"
          data-track="download_cta"
          data-track-ubicacion="tools_hub"
        >
          {t.chrome.ctaButton}
        </a>
        <p class="tools-cta__note">{t.chrome.ctaNote}</p>
      </section>

    </div>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
.tools-index {
  padding-top: clamp(96px, 12vw, 130px);
  padding-bottom: clamp(56px, 7vw, 90px);
}

.tool-crumbs {
  display: flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-faint);
  margin-bottom: 28px;
}
.tool-crumbs a:hover { color: var(--cyan); }
.tool-crumbs__current { color: var(--text-muted); text-transform: none; letter-spacing: 0; font-size: 12px; }

.tools-index__head { max-width: 700px; }
.tools-index__head h1 {
  font-size: clamp(32px, 5vw, 52px);
  font-weight: 900;
  letter-spacing: -0.035em;
  line-height: 1.05;
  margin-block: 14px 18px;
}
.tools-index__sub {
  font-size: 17px;
  line-height: 1.7;
  color: var(--text-muted);
}
.tools-index__count {
  margin-top: 14px;
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--cyan);
}

.tools-group { margin-top: clamp(44px, 6vw, 64px); }
.tools-group__title {
  font-size: 13px;
  font-family: var(--font-mono);
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--text-faint);
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 22px;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 14px;
  list-style: none;
}
.tools-grid a {
  display: flex;
  flex-direction: column;
  gap: 7px;
  height: 100%;
  padding: 20px 22px;
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  background: var(--bg-card);
  transition: border-color 0.15s, background 0.15s, transform 0.15s;
}
.tools-grid a:hover {
  border-color: var(--border-hi);
  background: rgba(255 255 255 / 0.06);
  transform: translateY(-2px);
}
.tools-card__title {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.015em;
  color: var(--text);
}
.tools-card__blurb {
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--text-muted);
}

.tools-cta {
  margin-top: clamp(56px, 7vw, 80px);
  padding: clamp(28px, 4vw, 44px);
  text-align: center;
}
.tools-cta h2 {
  font-size: clamp(22px, 3vw, 30px);
  font-weight: 900;
  letter-spacing: -0.03em;
  margin-bottom: 12px;
}
.tools-cta p {
  font-size: 15px;
  line-height: 1.7;
  color: var(--text-muted);
  max-width: 52ch;
  margin-inline: auto;
  margin-bottom: 24px;
}
.tools-cta__note {
  margin-top: 16px;
  margin-bottom: 0;
  font-size: 12.5px;
  color: var(--text-faint);
}
</style>
