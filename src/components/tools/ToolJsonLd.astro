---
/**
 * Datos estructurados de una página de herramienta: la herramienta en sí
 * (WebApplication), sus preguntas frecuentes (FAQPage) y la miga de pan
 * (BreadcrumbList). Los tres nodos van en un solo bloque para no repartir
 * scripts por el head.
 */
import type { Lang } from '../../i18n/ui';
import type { ToolContent } from '../../i18n/tools';
import { useToolTranslations } from '../../i18n/tools';
import { toolPath, toolsIndexPath } from '../../lib/tools';
import { SITE } from '../../config';

interface Props { lang: Lang; content: ToolContent; }
const { lang, content } = Astro.props;
const chrome = useToolTranslations(lang).chrome;

const url = `${SITE.url}${toolPath(content.slug, lang)}`;
const homeUrl = lang === 'en' ? `${SITE.url}/en/` : `${SITE.url}/`;

const data = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: content.h1,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web',
    browserRequirements: 'Requires JavaScript',
    description: content.metaDescription,
    url,
    inLanguage: lang,
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faq.map(item => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: chrome.breadcrumbHome, item: homeUrl },
      { '@type': 'ListItem', position: 2, name: chrome.breadcrumbTools, item: `${SITE.url}${toolsIndexPath(lang)}` },
      { '@type': 'ListItem', position: 3, name: content.h1, item: url },
    ],
  },
];
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
