---
import type { Lang } from '../../../i18n/ui';
import { useToolTranslations } from '../../../i18n/tools';
import { LANGUAGES } from '../../../lib/language-data';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const u = useToolTranslations(lang).widgets.detector;

/** franc devuelve ISO 639-3; el nombre legible sale de nuestra propia tabla. */
const names = Object.fromEntries(
  LANGUAGES.map(language => [language.iso3, lang === 'en' ? language.en : language.es]),
);

const labels = JSON.stringify({
  tooShort: u.tooShort,
  noMatch: u.noMatch,
  high: u.confidenceHigh,
  medium: u.confidenceMedium,
  low: u.confidenceLow,
});
---

<div class="tool-widget" id="w-detector" data-labels={labels} data-names={JSON.stringify(names)}>
  <div class="tool-field">
    <label class="tool-label" for="w-detector-text">{u.textLabel}</label>
    <textarea class="tool-textarea detector-text" id="w-detector-text" data-text placeholder={u.textPlaceholder}></textarea>
  </div>

  <p class="tool-alert tool-alert--warn" data-hint hidden></p>

  <div class="tool-result" data-result hidden>
    <span class="tool-result__label">{u.resultLabel}</span>
    <span class="tool-result__value" data-language></span>
    <span class="tool-result__hint">
      {u.confidenceLabel}: <strong data-confidence></strong> · <code data-code></code>
    </span>
  </div>

  <div class="tool-field" data-runners-up hidden>
    <span class="tool-label">{u.runnersUpLabel}</span>
    <ul class="detector-list" data-runners-list></ul>
  </div>
</div>

<style>
.detector-text { min-height: 160px; font-family: var(--font-body); font-size: 15px; }
.detector-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  list-style: none;
}
.detector-list li {
  padding: 5px 12px;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: rgba(255 255 255 / 0.03);
  font-size: 13px;
  color: var(--text-muted);
}
.detector-list code {
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--text-faint);
}
</style>

<script>
  import { francAll } from 'franc-min';
  import { reportToolUseOnce } from '../../../lib/tool-analytics';

  const root = document.getElementById('w-detector');

  if (root) {
    const labels = JSON.parse(root.dataset.labels ?? '{}');
    const names: Record<string, string> = JSON.parse(root.dataset.names ?? '{}');
    const text = root.querySelector<HTMLTextAreaElement>('[data-text]');
    const hint = root.querySelector<HTMLElement>('[data-hint]');
    const result = root.querySelector<HTMLElement>('[data-result]');
    const languageEl = root.querySelector<HTMLElement>('[data-language]');
    const confidenceEl = root.querySelector<HTMLElement>('[data-confidence]');
    const codeEl = root.querySelector<HTMLElement>('[data-code]');
    const runners = root.querySelector<HTMLElement>('[data-runners-up]');
    const runnersList = root.querySelector<HTMLElement>('[data-runners-list]');

    const nameOf = (code: string) => names[code] ?? code;

    function show(message: string | null) {
      if (!hint) return;
      hint.textContent = message ?? '';
      hint.hidden = !message;
      if (message) {
        if (result) result.hidden = true;
        if (runners) runners.hidden = true;
      }
    }

    function detect() {
      const value = text?.value.trim() ?? '';

      if (value.length < 20) {
        show(value.length ? labels.tooShort : null);
        return;
      }

      const candidates = francAll(value).filter(([code]) => code !== 'und');
      if (!candidates.length) {
        show(labels.noMatch);
        return;
      }

      show(null);
      reportToolUseOnce('detect');

      const [best, second] = candidates;
      // franc puntúa el mejor con 1: lo que dice si hay que fiarse es la
      // distancia con el segundo, no el valor absoluto del primero.
      const margin = 1 - (second?.[1] ?? 0);
      const confidence =
        margin > 0.15 ? labels.high : margin > 0.05 ? labels.medium : labels.low;

      if (result) result.hidden = false;
      if (languageEl) languageEl.textContent = nameOf(best[0]);
      if (confidenceEl) confidenceEl.textContent = confidence;
      if (codeEl) codeEl.textContent = best[0];

      // franc también propone lenguas sin código ISO 639-1, que no sabemos
      // nombrar: como candidato suelto, un código a secas no dice nada.
      const rest = candidates.slice(1).filter(([code]) => names[code]).slice(0, 4);
      if (runners && runnersList) {
        runners.hidden = rest.length === 0;
        runnersList.innerHTML = rest
          .map(([code]) => `<li>${nameOf(code)} <code>${code}</code></li>`)
          .join('');
      }
    }

    text?.addEventListener('input', detect);
  }
</script>
