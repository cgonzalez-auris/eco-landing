---
import FileDrop from '../FileDrop.astro';
import type { Lang } from '../../../i18n/ui';
import { useToolTranslations } from '../../../i18n/tools';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const w = useToolTranslations(lang).widgets;
const u = w.bilingual;
const s = w.subtitle;

const labels = JSON.stringify({
  parseError: s.parseError,
  emptyError: s.emptyError,
  copiedLabel: s.copiedLabel,
  cuesLabel: s.cuesLabel,
  cueLabelOne: s.cueLabelOne,
  countMismatch: u.countMismatch,
  needBoth: u.needBoth,
});
---

<div class="tool-widget" id="w-bilingual" data-labels={labels}>
  <div class="bilingual-sources">
    <div class="tool-field">
      <span class="tool-label">{u.originalLabel}</span>
      <FileDrop id="w-bilingual-original" main={s.dropLabel} sub={s.browseLabel} accept=".srt,.vtt,.txt,text/plain" />
      <p class="tool-file" data-slot="original" hidden>
        <span class="tool-file__name" data-name></span>
        <span class="tool-file__meta" data-meta></span>
      </p>
    </div>

    <div class="tool-field">
      <span class="tool-label">{u.translationLabel}</span>
      <FileDrop id="w-bilingual-translation" main={s.dropLabel} sub={s.browseLabel} accept=".srt,.vtt,.txt,text/plain" />
      <p class="tool-file" data-slot="translation" hidden>
        <span class="tool-file__name" data-name></span>
        <span class="tool-file__meta" data-meta></span>
      </p>
    </div>
  </div>

  <div class="tool-row">
    <div class="tool-field">
      <label class="tool-label" for="w-bilingual-order">{u.orderLabel}</label>
      <select class="tool-select" id="w-bilingual-order" data-order>
        <option value="original">{u.orderOriginalFirst}</option>
        <option value="translation">{u.orderTranslationFirst}</option>
      </select>
    </div>
    <div class="tool-field">
      <label class="tool-label" for="w-bilingual-sep">{u.separatorLabel}</label>
      <select class="tool-select" id="w-bilingual-sep" data-separator>
        <option value="">{u.separatorNone}</option>
        <option value="- ">- </option>
        <option value="— ">— </option>
      </select>
    </div>
  </div>

  <p class="tool-alert tool-alert--error" data-error hidden></p>
  <p class="tool-alert tool-alert--warn" data-warning hidden></p>

  <div class="tool-field">
    <div class="bilingual-output-head">
      <span class="tool-label">{s.resultLabel}</span>
      <span class="tool-count" data-count></span>
    </div>
    <pre class="tool-output" data-output></pre>
  </div>

  <div class="tool-actions">
    <button type="button" class="tool-btn tool-btn--primary" data-download data-tool-action="download" disabled>{s.downloadLabel}</button>
    <button type="button" class="tool-btn" data-copy data-tool-action="copy" disabled>{s.copyLabel}</button>
  </div>
</div>

<style>
.bilingual-sources {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 18px;
}
.bilingual-output-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 7px;
}
</style>

<script>
  import { type Cue, parseSubtitles, toSrt } from '../../../lib/subtitles';
  import { copyText, downloadText, flashLabel, pluralize } from '../../../lib/download';
  import { reportToolUseOnce } from '../../../lib/tool-analytics';

  const root = document.getElementById('w-bilingual');

  if (root) {
    const labels = JSON.parse(root.dataset.labels ?? '{}');
    const order = root.querySelector<HTMLSelectElement>('[data-order]');
    const separator = root.querySelector<HTMLSelectElement>('[data-separator]');
    const output = root.querySelector<HTMLElement>('[data-output]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const errorBox = root.querySelector<HTMLElement>('[data-error]');
    const warnBox = root.querySelector<HTMLElement>('[data-warning]');
    const copyBtn = root.querySelector<HTMLButtonElement>('[data-copy]');
    const downloadBtn = root.querySelector<HTMLButtonElement>('[data-download]');

    const loaded: Record<string, { name: string; cues: Cue[] } | null> = {
      original: null,
      translation: null,
    };
    let result = '';

    function show(box: HTMLElement | null, message: string | undefined) {
      if (!box) return;
      box.textContent = message ?? '';
      box.hidden = !message;
    }

    function render() {
      const a = loaded.original;
      const b = loaded.translation;

      if (!a || !b) {
        result = '';
        if (output) output.textContent = '';
        if (count) count.textContent = '';
        if (copyBtn) copyBtn.disabled = true;
        if (downloadBtn) downloadBtn.disabled = true;
        show(warnBox, a || b ? labels.needBoth : undefined);
        return;
      }

      const pairs = Math.min(a.cues.length, b.cues.length);
      const sep = separator?.value ?? '';
      const translationFirst = order?.value === 'translation';

      // Los tiempos que mandan son los del original: son los que están
      // sincronizados con el audio que se va a oír.
      const merged: Cue[] = Array.from({ length: pairs }, (_, i) => {
        const top = translationFirst ? b.cues[i] : a.cues[i];
        const bottom = translationFirst ? a.cues[i] : b.cues[i];
        return {
          start: a.cues[i].start,
          end: a.cues[i].end,
          lines: [top.lines.join(' '), `${sep}${bottom.lines.join(' ')}`],
        };
      });

      result = toSrt(merged);
      reportToolUseOnce('merge');
      if (output) output.textContent = result;
      if (count) count.textContent = pluralize(pairs, labels.cuesLabel, labels.cueLabelOne);
      if (copyBtn) copyBtn.disabled = false;
      if (downloadBtn) downloadBtn.disabled = false;
      show(
        warnBox,
        a.cues.length !== b.cues.length ? labels.countMismatch : undefined,
      );
    }

    root.querySelectorAll<HTMLElement>('[data-drop]').forEach(zone => {
      const key = zone.id.endsWith('translation') ? 'translation' : 'original';
      const row = root.querySelector<HTMLElement>(`[data-slot="${key}"]`);

      zone.addEventListener('tool:file', event => {
        const { name, text } = (event as CustomEvent<{ name: string; text: string }>).detail;

        if (!text.trim()) {
          show(errorBox, labels.emptyError);
          return;
        }
        try {
          loaded[key] = { name, cues: parseSubtitles(text) };
          show(errorBox, undefined);
        } catch {
          loaded[key] = null;
          show(errorBox, labels.parseError);
        }

        if (row) {
          const nameEl = row.querySelector<HTMLElement>('[data-name]');
          const metaEl = row.querySelector<HTMLElement>('[data-meta]');
          if (nameEl) nameEl.textContent = name;
          if (metaEl) {
            metaEl.textContent = loaded[key]
              ? pluralize(loaded[key]!.cues.length, labels.cuesLabel, labels.cueLabelOne)
              : '';
          }
          row.hidden = false;
        }
        render();
      });
    });

    [order, separator].forEach(el => el?.addEventListener('change', render));

    copyBtn?.addEventListener('click', async () => {
      if (result && (await copyText(result))) flashLabel(copyBtn, labels.copiedLabel);
    });

    downloadBtn?.addEventListener('click', () => {
      if (result) downloadText('bilingual.srt', result);
    });
  }
</script>
