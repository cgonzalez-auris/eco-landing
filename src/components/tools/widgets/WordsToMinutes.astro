---
import type { Lang } from '../../../i18n/ui';
import { useToolTranslations } from '../../../i18n/tools';
import { SPEECH_RATES } from '../../../lib/speech-rate';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const u = useToolTranslations(lang).widgets.wpm;

const display = new Intl.DisplayNames([lang], { type: 'language' });
const capitalize = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);

const languages = SPEECH_RATES.map(rate => ({
  code: rate.code,
  label: capitalize(display.of(rate.code) ?? rate.code),
}));

const labels = JSON.stringify({
  wpmSuffix: u.wpmSuffix,
  readingResult: u.readingResult,
  speakingResult: u.speakingResult,
  wordsResult: u.wordsResult,
});
---

<div class="tool-widget" id="w-wpm" data-labels={labels}>
  <div class="tool-field">
    <label class="tool-label" for="w-wpm-mode">{u.modeLabel}</label>
    <select class="tool-select" id="w-wpm-mode" data-mode>
      <option value="words">{u.modeFromWords}</option>
      <option value="minutes">{u.modeFromMinutes}</option>
    </select>
  </div>

  <div class="tool-row">
    <div class="tool-field" data-input="words">
      <label class="tool-label" for="w-wpm-words">{u.wordsLabel}</label>
      <input class="tool-input" type="number" id="w-wpm-words" data-words value="800" min="1" step="10" />
    </div>

    <div class="tool-field" data-input="minutes" hidden>
      <label class="tool-label" for="w-wpm-minutes">{u.minutesLabel}</label>
      <input class="tool-input" type="number" id="w-wpm-minutes" data-minutes value="10" min="1" step="1" />
    </div>

    <div class="tool-field">
      <label class="tool-label" for="w-wpm-lang">{u.langLabel}</label>
      <select class="tool-select" id="w-wpm-lang" data-lang>
        {languages.map(language => (
          <option value={language.code} selected={language.code === lang}>{language.label}</option>
        ))}
      </select>
    </div>

    <div class="tool-field">
      <label class="tool-label" for="w-wpm-pace">{u.paceLabel}</label>
      <select class="tool-select" id="w-wpm-pace" data-pace>
        <option value="slow">{u.paceSlow}</option>
        <option value="normal" selected>{u.paceNormal}</option>
        <option value="fast">{u.paceFast}</option>
      </select>
    </div>
  </div>

  <div class="tool-results-grid">
    <div class="tool-result" data-primary>
      <span class="tool-result__label" data-primary-label></span>
      <span class="tool-result__value" data-primary-value></span>
      <span class="tool-result__hint" data-primary-hint></span>
    </div>
    <div class="tool-result" data-secondary>
      <span class="tool-result__label" data-secondary-label></span>
      <span class="tool-result__value" data-secondary-value></span>
      <span class="tool-result__hint" data-secondary-hint></span>
    </div>
  </div>

  <p class="tool-note">{u.note}</p>
</div>

<script>
  import { PACE_FACTOR, type Pace, formatDuration, rateFor } from '../../../lib/speech-rate';
  import { reportToolUseOnce } from '../../../lib/tool-analytics';

  const root = document.getElementById('w-wpm');

  if (root) {
    const labels = JSON.parse(root.dataset.labels ?? '{}');
    const mode = root.querySelector<HTMLSelectElement>('[data-mode]');
    const words = root.querySelector<HTMLInputElement>('[data-words]');
    const minutes = root.querySelector<HTMLInputElement>('[data-minutes]');
    const langSelect = root.querySelector<HTMLSelectElement>('[data-lang]');
    const pace = root.querySelector<HTMLSelectElement>('[data-pace]');
    const wordsField = root.querySelector<HTMLElement>('[data-input="words"]');
    const minutesField = root.querySelector<HTMLElement>('[data-input="minutes"]');

    const set = (key: string, label: string, value: string, hint: string) => {
      const labelEl = root.querySelector<HTMLElement>(`[data-${key}-label]`);
      const valueEl = root.querySelector<HTMLElement>(`[data-${key}-value]`);
      const hintEl = root.querySelector<HTMLElement>(`[data-${key}-hint]`);
      if (labelEl) labelEl.textContent = label;
      if (valueEl) valueEl.textContent = value;
      if (hintEl) hintEl.textContent = hint;
    };

    function render() {
      const fromWords = mode?.value !== 'minutes';
      if (wordsField) wordsField.hidden = !fromWords;
      if (minutesField) minutesField.hidden = fromWords;

      const rate = rateFor(langSelect?.value ?? 'es');
      const factor = PACE_FACTOR[(pace?.value as Pace) ?? 'normal'];
      const speaking = rate.speaking * factor;
      const secondary = root.querySelector<HTMLElement>('[data-secondary]');

      if (fromWords) {
        const total = Math.max(0, Number(words?.value) || 0);
        if (secondary) secondary.hidden = false;
        set(
          'primary',
          labels.speakingResult,
          formatDuration(total / speaking),
          `${Math.round(speaking)} ${labels.wpmSuffix}`,
        );
        set(
          'secondary',
          labels.readingResult,
          formatDuration(total / rate.reading),
          `${rate.reading} ${labels.wpmSuffix}`,
        );
      } else {
        const total = Math.max(0, Number(minutes?.value) || 0);
        // Aquí solo hay una respuesta posible: cuántas palabras caben hablando.
        if (secondary) secondary.hidden = true;
        set(
          'primary',
          labels.wordsResult,
          Math.round(total * speaking).toLocaleString(document.documentElement.lang || 'es'),
          `${Math.round(speaking)} ${labels.wpmSuffix}`,
        );
      }
    }

    // El render inicial no cuenta como uso: solo lo que toca la persona.
    const onInteraction = () => {
      reportToolUseOnce('calculate');
      render();
    };
    [mode, words, minutes, langSelect, pace].forEach(el => {
      el?.addEventListener('input', onInteraction);
      el?.addEventListener('change', onInteraction);
    });
    render();
  }
</script>
