---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang).hiw;

const icons = [
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/></svg>`,
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
];
const colors = ['#A78BFA', '#6366F1', '#34D399'];
---

<section class="section hiw" id="how-it-works">
  <div class="container">
    <div class="section-label">{t.label}</div>
    <h2 class="hiw__title reveal">
      {t.title.split('\n').map((line, i) => (
        <>{line}{i < t.title.split('\n').length - 1 && <br/>}</>
      ))}
    </h2>

    <div class="hiw__steps">
      {t.steps.map((step, i) => (
        <div class="hiw__step reveal" style={`animation-delay: ${i * 0.12}s`}>
          <div class="hiw__step-head">
            <div class="hiw__num" style={`color: ${colors[i]}; border-color: ${colors[i]}40`}>{step.n}</div>
            {i < t.steps.length - 1 && <div class="hiw__connector" aria-hidden="true"></div>}
          </div>
          <div class="hiw__step-body">
            <div class="hiw__icon" style={`color: ${colors[i]}; background: ${colors[i]}12; border-color: ${colors[i]}25`} set:html={icons[i]} />
            <h3 class="hiw__step-title">{step.title}</h3>
            <p class="hiw__step-desc">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.hiw__title {
  font-size: clamp(30px, 3.8vw, 48px);
  font-weight: 900;
  letter-spacing: -0.03em;
  margin-bottom: 60px;
  max-width: 560px;
  line-height: 1.05;
}

.hiw__steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  position: relative;
}

.hiw__step {
  display: flex;
  flex-direction: column;
  padding-right: 40px;
}
.hiw__step:last-child { padding-right: 0; }

.hiw__step-head {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 24px;
}

.hiw__num {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.04em;
  border: 1px solid;
  padding: 4px 10px;
  border-radius: 99px;
  flex-shrink: 0;
}

.hiw__connector {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, var(--border-hi) 0%, transparent 100%);
  margin-left: 12px;
}

.hiw__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: var(--r-md);
  border: 1px solid;
  margin-bottom: 16px;
}

.hiw__step-title {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 10px;
  letter-spacing: -0.02em;
}

.hiw__step-desc {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.7;
}

@media (max-width: 768px) {
  .hiw__steps {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .hiw__step { padding-right: 0; }
  .hiw__connector { display: none; }
}
</style>
