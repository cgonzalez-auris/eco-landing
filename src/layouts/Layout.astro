---
import type { Lang } from '../i18n/ui';
import AnalyticsScripts from '../components/AnalyticsScripts.astro';
import EventTracker from '../components/EventTracker.astro';
import { DOWNLOAD } from '../config';

export interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  lang = 'es',
  title = lang === 'en'
    ? 'Eco — Real-Time Transcription & Translation for Mac, iPhone and Android'
    : 'Eco — Transcripción y Traducción en Tiempo Real para Mac, iPhone y Android',
  description = lang === 'en'
    ? 'Eco captures your microphone and system audio, transcribes and translates in real time. For meetings, classes, and videos in another language. Mac, iPhone and Android.'
    : 'Eco captura el audio de tu micrófono y del sistema, transcribe y traduce en tiempo real. Para reuniones, clases y videos en otro idioma. Mac, iPhone y Android.',
  canonical = Astro.url.href,
  ogImage = '/og-image.png',
} = Astro.props;

const siteUrl = 'https://ecotranslate.app';
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
const altEs = `${siteUrl}/`;
const altEn = `${siteUrl}/en/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Eco',
  operatingSystem: 'macOS 14.4+, iOS 17+, Android 8+',
  applicationCategory: 'ProductivityApplication',
  description,
  url: siteUrl,
  // Una suscripción vale en las tres apps, así que se declaran las tres fichas
  // como la misma aplicación en vez de tres SoftwareApplication distintas.
  downloadUrl: [`${siteUrl}/download/mac`, DOWNLOAD.appStore, DOWNLOAD.playStore],
  offers: [
    { '@type': 'Offer', name: lang === 'en' ? 'Free' : 'Gratuito', price: '0', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Lite', price: '8.99', priceCurrency: 'USD', billingIncrement: 'P1M' },
    { '@type': 'Offer', name: 'Pro', price: '19.99', priceCurrency: 'USD', billingIncrement: 'P1M' },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07050E" />

    <!-- SEO Primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Eco" />
    <meta property="og:locale" content={ogLocale} />
    {lang === 'en'
      ? <meta property="og:locale:alternate" content="es_ES" />
      : <meta property="og:locale:alternate" content="en_US" />
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Robots -->
    <meta name="robots" content="index, follow" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/app-icon.png" sizes="128x128" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts: Montserrat (display) + Nunito (body) + Space Mono (code labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,500;0,600;0,700;0,800;0,900;1,700&family=Nunito:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Analítica: Umami + Vercel Web Analytics, solo en producción -->
    <AnalyticsScripts />
  </head>
  <body>
    <slot />

    <EventTracker />

    <!-- Scroll reveal -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }),
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>

  </body>
</html>
