---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  lang="es"
  title="Checkout — Eco"
  description="Activa tu suscripción a Eco."
  canonical="https://ecotranslate.app/checkout-success"
>
  <Nav lang="es" />

  <main class="checkout-page">
    <div class="container">

      <!-- Estado: cargando checkout -->
      <div class="card" id="state-loading">
        <div class="spinner" aria-hidden="true"></div>
        <p class="loading-text">Cargando formulario de pago…</p>
      </div>

      <!-- Estado: cerrado sin pagar -->
      <div class="card hidden" id="state-cancelled">
        <div class="icon-wrap-muted" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
        </div>
        <h1>Pago cancelado</h1>
        <p class="sub">No se realizó ningún cargo. Puedes volver e intentarlo cuando quieras.</p>
        <a href="/" class="btn-home">Volver al inicio</a>
      </div>

      <!-- Estado: pago completado -->
      <div class="card hidden" id="state-success">
        <div class="icon-wrap" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <polyline points="9 12 11 14 15 10" />
          </svg>
        </div>

        <h1>¡Suscripción activada!</h1>
        <p class="sub">
          Tu plan ya está activo. Abre la app Eco y verás el plan actualizado automáticamente.
        </p>

        <div class="steps">
          <div class="step">
            <span class="step-num">1</span>
            <span>Abre <strong>Eco</strong> en tu Mac</span>
          </div>
          <div class="step">
            <span class="step-num">2</span>
            <span>El plan se actualiza solo — no necesitas hacer nada más</span>
          </div>
          <div class="step">
            <span class="step-num">3</span>
            <span>¡Empieza a grabar con tu nuevo límite de minutos!</span>
          </div>
        </div>

        <a href="eco://upgrade-complete" class="btn-open-app">Abrir Eco</a>
        <a href="/" class="link-home">Volver al inicio</a>

        <p class="help">
          ¿Problemas? Escríbenos a
          <a href="mailto:hola@ecotranslate.app">hola@ecotranslate.app</a>
        </p>
      </div>

    </div>
  </main>

  <Footer lang="es" />
</Layout>

<!-- Paddle.js — se carga solo cuando hay _ptxn en la URL -->
<script>
  const params   = new URLSearchParams(window.location.search);
  const ptxn     = params.get('_ptxn');
  const stateLoading   = document.getElementById('state-loading')!;
  const stateSuccess   = document.getElementById('state-success')!;
  const stateCancelled = document.getElementById('state-cancelled')!;

  function showSuccess() {
    stateLoading.classList.add('hidden');
    stateCancelled.classList.add('hidden');
    stateSuccess.classList.remove('hidden');
  }

  function showCancelled() {
    stateLoading.classList.add('hidden');
    stateCancelled.classList.remove('hidden');
  }

  let completed = false;

  if (!ptxn) {
    // No hay transacción pendiente — llegó directo (ej. después del pago)
    showSuccess();
  } else {
    // Cargar Paddle.js e iniciar el overlay de checkout
    const script = document.createElement('script');
    script.src = 'https://cdn.paddle.com/paddle/v2/paddle.js';
    script.onload = () => {
      const w = window as any;
      // CLIENT_TOKEN se reemplaza por el token real más abajo
      const token: string = 'test_3373b926370a7fa1b6e03ab3bc0';
      const isSandbox = token.startsWith('test_');

      if (isSandbox) w.Paddle.Environment.set('sandbox');

      w.Paddle.Initialize({
        token,
        eventCallback(data: any) {
          if (data.name === 'checkout.completed') { completed = true; showSuccess(); }
          if (data.name === 'checkout.closed' && !completed) showCancelled();
        },
      });

      // Hide our spinner once Paddle takes over
      stateLoading.classList.add('hidden');

      w.Paddle.Checkout.open({ transactionId: ptxn });
    };
    document.head.appendChild(script);
  }
</script>

<style>
.checkout-page {
  min-height: 100svh;
  display: flex;
  align-items: center;
  padding: 120px 24px 80px;
}

.container {
  max-width: var(--max-w);
  margin: 0 auto;
  width: 100%;
  display: flex;
  justify-content: center;
}

.card {
  background: var(--bg-surface);
  border: 1px solid var(--border-hi);
  border-radius: var(--r-lg);
  padding: clamp(40px, 6vw, 64px) clamp(32px, 5vw, 56px);
  max-width: 520px;
  width: 100%;
  text-align: center;
  box-shadow:
    0 0 0 1px rgba(167 139 250 / 0.06),
    0 40px 100px rgba(0 0 0 / 0.6);
}

.hidden { display: none !important; }

/* Loading spinner */
.spinner {
  width: 48px;
  height: 48px;
  border: 3px solid rgba(167 139 250 / 0.2);
  border-top-color: var(--cyan);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 20px;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  font-size: 15px;
  color: var(--text-muted);
}

.icon-wrap-muted {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: rgba(255 255 255 / 0.04);
  border: 1px solid rgba(255 255 255 / 0.1);
  color: var(--text-faint);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px;
}

/* Success state */
.icon-wrap {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--emerald-dim);
  border: 1px solid rgba(52 211 153 / 0.25);
  color: var(--emerald);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28px;
}

h1 {
  font-family: var(--font-display);
  font-size: clamp(26px, 4vw, 34px);
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--text);
  margin-bottom: 14px;
  line-height: 1.2;
}

.sub {
  font-size: 16px;
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 36px;
}

.steps {
  display: flex;
  flex-direction: column;
  gap: 14px;
  text-align: left;
  margin-bottom: 36px;
}

.step {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.6;
}

.step strong { color: var(--text); }

.step-num {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--cyan-dim);
  border: 1px solid rgba(167 139 250 / 0.3);
  color: var(--cyan);
  font-size: 12px;
  font-weight: 700;
  font-family: var(--font-mono);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 1px;
}

.btn-open-app {
  display: inline-block;
  background: linear-gradient(135deg, var(--cyan), var(--indigo));
  color: #fff;
  font-weight: 700;
  font-size: 15px;
  padding: 13px 32px;
  border-radius: var(--r-md);
  text-decoration: none;
  transition: opacity 0.15s;
  margin-bottom: 14px;
}
.btn-open-app:hover { opacity: 0.88; }

.link-home {
  display: block;
  font-size: 13px;
  color: var(--text-faint);
  text-decoration: underline;
  text-underline-offset: 3px;
  margin-bottom: 28px;
}
.link-home:hover { opacity: 0.8; }

.help {
  font-size: 13px;
  color: var(--text-faint);
}
.help a {
  color: var(--cyan);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.help a:hover { opacity: 0.8; }
</style>
